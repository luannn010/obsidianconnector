# Optional override for the registered-vault configuration file.
OBSIDIAN_MCP_CONFIG=config/vaults.json

# Only vaults under this directory are listed by list_vaults.
OBSIDIAN_VAULT_ROOT=G:\\My Drive\\.obsidian

# Standard profile exposes only the five SQL-backed project knowledge tools.
OBSIDIAN_MCP_PROFILE=admin
PROJECT_KNOWLEDGE_DATABASE_URL=postgresql://obsidian_connector:change-me@127.0.0.1:5432/playnode
PROJECT_KNOWLEDGE_MIGRATION_DATABASE_URL=postgresql://playnode:change-me@127.0.0.1:5432/playnode
PROJECT_KNOWLEDGE_DB_POOL_MAX=4
PROJECT_KNOWLEDGE_STATEMENT_TIMEOUT_MS=5000
PROJECT_KNOWLEDGE_EMBEDDING_BASE_URL=http://127.0.0.1:8080
PROJECT_KNOWLEDGE_EMBEDDING_TOKEN=replace-with-long-random-token
PROJECT_KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
PROJECT_KNOWLEDGE_EMBEDDING_DIMENSIONS=384
PROJECT_KNOWLEDGE_RERANKER_ENABLED=true
PROJECT_KNOWLEDGE_RERANKER_BASE_URL=http://127.0.0.1:8080
PROJECT_KNOWLEDGE_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
PROJECT_KNOWLEDGE_RERANKER_TOKEN=replace-with-long-random-token
# The model container accepts one token; use the same value for both client
# tokens when embeddings and reranking share this local service.
RETRIEVAL_MODEL_BEARER_TOKEN=replace-with-long-random-token
RETRIEVAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_EMBEDDING_DIMENSIONS=384
RETRIEVAL_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_MODEL_MAX_CONCURRENCY=2
RETRIEVAL_MODEL_MEMORY_LIMIT=4g
PROJECT_KNOWLEDGE_PROJECT_KEY=MC-Platform
PROJECT_KNOWLEDGE_PROJECT_NAME=MC-Platform
PROJECT_KNOWLEDGE_REPOSITORY_PATH=C:\\Users\\luann\\Documents\\MC-Platform
PROJECT_KNOWLEDGE_VAULT_PATH=G:\\My Drive\\.obsidian\\MC-Platform
PROJECT_KNOWLEDGE_WORKER_ONCE=false
